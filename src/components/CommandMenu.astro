---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const subjects = await getCollection('subjects');

const items = [
  { group: 'go to', label: 'Home', href: '/' },
  { group: 'go to', label: 'Writing', href: '/posts/' },
  { group: 'go to', label: 'Class notes', href: '/subjects/' },
  { group: 'go to', label: 'CV', href: '/cv/' },
  { group: 'go to', label: 'Contact', href: '/contact/' },
  { group: 'go to', label: 'C++ IDE for Android', href: '/cpp-ide/' },
  { group: 'play', label: 'Ludo 3D', href: 'https://ludo.shahidkhan.dev' },
  ...posts.map((p) => ({ group: 'read', label: p.data.title, href: `/posts/${p.id}/` })),
  ...subjects.map((s) => ({ group: 'class', label: s.data.title, href: `/subjects/${s.id}/` })),
];
---

<dialog class="menu" aria-label="Menu" data-menu>
  <input type="text" placeholder="Where to?" aria-label="Search pages" autocomplete="off" spellcheck="false" data-menu-input />
  <ul role="listbox" data-menu-list>
    <li role="option" data-action="lamp">
      <span class="mono group">do</span>
      <span>Flip the lamp</span>
    </li>
    {
      items.map((item) => (
        <li role="option" data-href={item.href}>
          <span class="mono group">{item.group}</span>
          <span>{item.label}</span>
        </li>
      ))
    }
  </ul>
  <p class="mono hint">
    <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
    <span><kbd>enter</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </p>
</dialog>

<script>
  // A small command menu. It opens with Ctrl/Cmd+K or "/".
  // It has no open or close animation on purpose: it is used from the
  // keyboard, and a keyboard action should feel instant.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-menu-input]')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  let active = 0;

  const visible = () => options.filter((o) => !o.hidden);

  const highlight = (index: number) => {
    const list = visible();
    if (!list.length) return;
    active = (index + list.length) % list.length;
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    list[active].setAttribute('aria-selected', 'true');
    list[active].scrollIntoView({ block: 'nearest' });
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    options.forEach((o) => (o.hidden = false));
    dialog.showModal();
    highlight(0);
  };

  const run = (option: HTMLLIElement | undefined) => {
    if (!option) return;
    dialog.close();
    if (option.dataset.action === 'lamp') {
      document.dispatchEvent(new Event('lamp:toggle'));
    } else if (option.dataset.href) {
      location.href = option.dataset.href;
    }
  };

  document.querySelector('[data-menu-open]')?.addEventListener('click', open);

  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    options.forEach((o) => (o.hidden = !o.lastElementChild!.textContent!.toLowerCase().includes(q)));
    highlight(0);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      run(visible()[active]);
    }
  });

  options.forEach((o) => {
    o.addEventListener('click', () => run(o));
    o.addEventListener('pointermove', () => highlight(visible().indexOf(o)));
  });

  // Click on the backdrop closes the menu.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .menu {
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(28rem, 70dvh);
    margin: 12dvh auto auto;
    padding: 0;
    display: none;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .menu[open] {
    display: flex;
  }

  .menu::backdrop {
    background: rgb(10 8 6 / 0.35);
  }

  input {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.1rem;
    outline: none;
  }

  input::placeholder {
    color: var(--faint);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
    flex: 1;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.5rem 0.7rem;
    border-radius: 7px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1.35;
  }

  li[hidden] {
    display: none;
  }

  li[aria-selected='true'] {
    background: var(--bg-raised);
  }

  .group {
    flex: 0 0 3.2rem;
    color: var(--faint);
    font-size: 0.72rem;
  }

  .hint {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.72rem;
  }

  @media (hover: none) {
    .hint {
      display: none;
    }
  }
</style>
