---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import FileList from '../../../components/FileList.astro';
import { formatDate, isoDate } from '../../../consts';

export const getStaticPaths = (async () => {
  const subjects = await getCollection('subjects');
  const classes = await getCollection('classes');
  return subjects.map((subject) => ({
    params: { subject: subject.id },
    props: {
      subject,
      classes: classes
        .filter((c) => c.id.startsWith(`${subject.id}/`))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}) satisfies GetStaticPaths;

const { subject, classes } = Astro.props;
const { Content } = await render(subject);
const counts = (c: (typeof classes)[number]) =>
  [
    [c.data.videos.length, 'video'],
    [c.data.audio.length, 'audio'],
    [c.data.images.length, 'image'],
    [c.data.documents.length, 'file'],
  ]
    .filter(([n]) => n)
    .map(([n, label]) => `${n} ${label}${n === 1 || label === 'audio' ? '' : 's'}`)
    .join(' · ');
---

<Base title={subject.data.title} description={subject.data.description}>
  <header class="page-head">
    <p class="mono muted">
      <a href="/subjects/">class notes</a> / {subject.data.subject_code}
    </p>
    <h1>{subject.data.title}</h1>
    <p class="muted">{subject.data.professor}. {subject.data.description}.</p>
  </header>

  <div class="prose"><Content /></div>

  {
    subject.data.courseOutline.length > 0 && (
      <>
        <SectionHead n="01" title="Course outline" />
        <FileList files={subject.data.courseOutline} />
      </>
    )
  }

  <SectionHead n={subject.data.courseOutline.length ? '02' : '01'} title="Classes" />
  {
    classes.length === 0 ? (
      <p class="muted">No classes uploaded yet.</p>
    ) : (
      <>
        <input class="search" type="search" placeholder="Search topics" aria-label="Search classes" data-search />
        <ol class="classes" data-classes>
          {classes.map((c) => (
            <li data-text={`${c.data.title} ${c.data.topics.join(' ')}`.toLowerCase()}>
              <a href={`/subjects/${c.id.replace('/', '/classes/')}/`}>
                <time class="mono" datetime={isoDate(c.data.date)}>
                  {formatDate(c.data.date)}
                </time>
                <span class="title">{c.data.title}</span>
                {c.data.topics.length > 0 && <span class="topics">{c.data.topics.slice(0, 4).join(', ')}</span>}
                {counts(c) && <span class="mono counts">{counts(c)}</span>}
              </a>
            </li>
          ))}
        </ol>
        <p class="mono muted" data-empty hidden>
          Nothing matches that.
        </p>
      </>
    )
  }
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const items = [...document.querySelectorAll<HTMLLIElement>('[data-classes] li')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      item.hidden = !item.dataset.text!.includes(q);
      if (!item.hidden) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>

<style>
  .page-head {
    padding-top: 3rem;
  }

  .prose {
    margin-top: 1rem;
  }

  .search {
    width: 100%;
    margin-bottom: 0.8rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
  }

  .classes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .classes a {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.1rem 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .classes time {
    grid-row: span 3;
    padding-top: 0.3rem;
    color: var(--faint);
  }

  .title {
    transition: color 160ms ease;
  }

  .topics {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .counts {
    color: var(--faint);
    font-size: 0.72rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .classes a:hover .title {
      color: var(--accent);
    }
  }

  @media (max-width: 30rem) {
    .classes a {
      grid-template-columns: 1fr;
    }
    .classes time {
      grid-row: auto;
    }
  }
</style>
