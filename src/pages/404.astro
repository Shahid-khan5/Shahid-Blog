---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <header class="page-head">
    <p class="mono muted">404</p>
    <h1>This page is not here.</h1>
    <p>
      It may have moved when I rebuilt the site. Press <kbd>/</kbd> to search, or go back <a href="/">home</a>.
    </p>
  </header>
</Base>

<style>
  .page-head {
    padding-top: 3rem;
  }
</style>
